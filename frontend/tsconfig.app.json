{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["src"]
}
